    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Main File with default Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "cloverparse.py",
            "console": "integratedTerminal",
            "args": "pattern"
        },
        {
            "name": "Python Debugger: Main File with custom Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "cloverparse.py",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}